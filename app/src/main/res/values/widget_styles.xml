<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/widget_line</item>
        <item name="android:ellipsize">end</item>
        <!-- One line each, so three fit a 4×3 widget without the last one being cut through. -->
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">@color/widget_on_surface</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
