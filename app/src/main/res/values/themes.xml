<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Leaf" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window</item>
    </style>

    <!-- Quick capture draws only its sheet and scrim; whatever was on screen stays visible behind. -->
    <style name="Theme.Leaf.Capture">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
