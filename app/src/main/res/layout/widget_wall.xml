<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widget_lines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_title"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_empty"
            style="@style/WidgetLine"
            android:text="@string/widget_empty"
            android:textColor="@color/widget_on_surface_variant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_line_1"
            style="@style/WidgetLine" />

        <TextView
            android:id="@+id/widget_line_2"
            style="@style/WidgetLine" />

        <TextView
            android:id="@+id/widget_line_3"
            style="@style/WidgetLine" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_write"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_write" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/quick_write"
                android:textColor="@color/widget_on_primary_container"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_speak"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/quick_speak"
            android:scaleType="center"
            android:src="@drawable/ic_widget_speak" />
    </LinearLayout>
</LinearLayout>
